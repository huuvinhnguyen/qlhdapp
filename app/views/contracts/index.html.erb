<h1>Contract List</h1>


<table class="table">
  <thead>
    <tr>
      <th>Contract Name</th>
      <th>Description</th>
      <th>Contract Date</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @contracts.each do |contract| %>
      <tr>
        <td><%= contract.name %></td>
        <td><%= contract.description %></td>
        <td><%= contract.contract_date %></td>
        <td>
          <%= link_to 'View', contract_path(contract), class: 'btn btn-info' %>
          <%= link_to 'Edit', edit_contract_path(contract), class: 'btn btn-warning' %>
          <%= button_to 'Delete', contract, method: :delete, data: { confirm: 'Are you sure you want to delete this contract?' }, class: 'btn btn-danger' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<%= link_to 'Add Contract', new_contract_path, class: 'btn btn-success' %>


