<!DOCTYPE html>
<html>
  <head>
    <title>Qlhdapp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
      <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">

          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
          </button>

          <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
              
              <li class="nav-item">
                <%= link_to "All Payments", payments_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "By Manufacture", manufactures_payments_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "New Payment", new_payment_path, class: "nav-link btn btn-success text-white px-3" %>
              </li>
            </ul>
          </div>
        </div>
      </nav>
      <div class="content-main">
        <%= yield %>
      </div>
  </body>
</html>
