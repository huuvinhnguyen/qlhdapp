<h1>Payment List</h1>

<table class="table">
  <thead>
    <tr>
      <th>Contract No</th>
      <th>Product Name</th>
      <th>Status</th>
      <th>Amount</th>
      <th>Payment Date</th>
      <th>Bank</th>
      <th>Personal</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @payments.each do |payment| %>
      <tr>
        <td><%= payment.contract&.contract_no %></td>
        <td><%= payment.product_name %></td>
        <td><%= payment.status&.name %></td>
        <td><%= number_to_currency(payment.amount) %></td>
        <td><%= payment.payment_date %></td>
        <td><%= payment.bank_transactions.first&.amount %></td>
        <td><%= payment.personal_transactions.first&.amount %></td>


        <td>
          <%= link_to 'View', payment_path(payment), class: 'btn btn-info' %>
          <%= link_to 'Edit', edit_payment_path(payment), class: 'btn btn-warning' %>
          <%= button_to 'Delete', payment, method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-danger' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to 'Add Payment', new_payment_path, class: 'btn btn-success' %>

