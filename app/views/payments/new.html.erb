<h1><%= @payment.new_record? ? "Add New Payment" : "Edit Payment" %></h1>

<%= form_with model: @payment, local: true do |f| %>
  <div>
    <%= f.label :name, "Name" %>
    <%= f.text_field :name, required: true %>
  </div>

  <div>
    <%= f.label :description, "Description" %>
    <%= f.text_area :description %>
  </div>

  <div>
    <%= f.label :amount, "Amount" %>
    <%= f.number_field :amount, step: 0.01, required: true %>
  </div>

  <div>
    <%= f.label :payment_date, "Payment Date" %>
    <%= f.date_field :payment_date, required: true %>
  </div>

  <div>
    <%= f.submit @payment.new_record? ? "Create Payment" : "Update Payment", class: "btn btn-primary" %>
  </div>
<% end %>

<%= link_to 'Back to List', payments_path, class: 'btn btn-secondary' %>
